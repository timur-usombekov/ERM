<Window x:Class="ERM.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="ERM — Швейный цех" Height="760" Width="1180"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <md:DialogHost Identifier="RootDialog" DialogTheme="Inherit">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════════════════
                 БОКОВАЯ ПАНЕЛЬ
            ═══════════════════════════════════════════════════════ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource MaterialDesignPaper}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ── Логотип / Бренд ── -->
                    <Border Grid.Row="0" Padding="20,28,20,24"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="Transparent"
                                    BorderBrush="{DynamicResource PrimaryHueLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10" Width="40" Height="40">
                                <md:PackIcon Kind="Scissors"
                                             Width="20" Height="20"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="ERM System"
                                           FontSize="17" FontWeight="Bold"
                                           Foreground="{DynamicResource MaterialDesignBody}"/>
                                <TextBlock Text="Швейный цех"
                                           FontSize="11"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── Главное меню ── -->
                    <StackPanel Grid.Row="1" Margin="0,16,0,0">

                        <!-- Метка группы -->
                        <TextBlock Text="РАБОЧАЯ СМЕНА"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   Opacity="0.55" Margin="24,0,0,10"/>

                        <!-- Пункт: Выдача кроя -->
                        <Border x:Name="DashboardItem" CornerRadius="0" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Rectangle x:Name="DashboardAccent" Grid.Column="0"
                                           Fill="{DynamicResource PrimaryHueMidBrush}"
                                           RadiusX="3" RadiusY="3" Opacity="0"/>

                                <Button Grid.Column="1"
                                        Command="{Binding NavigateToDashboardCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        HorizontalContentAlignment="Left"
                                        Height="46" Padding="18,0"
                                        Foreground="{DynamicResource MaterialDesignBody}">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="ClipboardTextClockOutline"
                                                     Width="20" Height="20"
                                                     Margin="0,0,14,0" Opacity="0.75"
                                                     VerticalAlignment="Center"/>
                                        <TextBlock Text="Журнал смены"
                                                   FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Border CornerRadius="0" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Rectangle Grid.Column="0"
                                           Fill="{DynamicResource PrimaryHueMidBrush}"
                                           RadiusX="3" RadiusY="3" Opacity="0"/>

                                <Button Grid.Column="1" 
                                        Command="{Binding NavigateToPayrollCommand}" 
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        HorizontalContentAlignment="Left" 
                                        Height="46" Padding="18,0"
                                        Foreground="{DynamicResource MaterialDesignBody}">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="CashCheck" Width="20" Height="20" Margin="0,0,14,0" Opacity="0.75" VerticalAlignment="Center"/>
                                        <TextBlock Text="Зарплаты" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Пункт: Управление кроем -->
                        <Border CornerRadius="0" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Rectangle Grid.Column="0"
                                           Fill="{DynamicResource PrimaryHueMidBrush}"
                                           RadiusX="3" RadiusY="3" Opacity="0"/>

                                <Button Grid.Column="1"
                                        Command="{Binding NavigateToCutBatchesCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        HorizontalContentAlignment="Left"
                                        Height="46" Padding="18,0"
                                        Foreground="{DynamicResource MaterialDesignBody}">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="FileDocumentOutline"
                                                     Width="20" Height="20"
                                                     Margin="0,0,14,0" Opacity="0.75"
                                                     VerticalAlignment="Center"/>
                                        <TextBlock Text="Управление кроем"
                                                   FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ── Справочники (внизу) ── -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,20">
                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="0,1,0,0"
                                Margin="20,0,20,12"/>

                        <TextBlock Text="СПРАВОЧНИКИ"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   Opacity="0.55" Margin="24,0,0,10"/>

                        <!-- Модели одежды -->
                        <Border CornerRadius="0" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Rectangle Grid.Column="0"
                                           Fill="{DynamicResource PrimaryHueMidBrush}"
                                           RadiusX="3" RadiusY="3" Opacity="0"/>

                                <Button Grid.Column="1"
                                        Command="{Binding NavigateToClothingModelsCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        HorizontalContentAlignment="Left"
                                        Height="40" Padding="18,0"
                                        Foreground="{DynamicResource MaterialDesignBody}">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="TshirtCrewOutline"
                                                     Width="18" Height="18"
                                                     Margin="0,0,14,0" Opacity="0.65"
                                                     VerticalAlignment="Center"/>
                                        <TextBlock Text="Модели одежды"
                                                   FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Сотрудники -->
                        <Border CornerRadius="0" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Rectangle Grid.Column="0"
                                           Fill="{DynamicResource PrimaryHueMidBrush}"
                                           RadiusX="3" RadiusY="3" Opacity="0"/>

                                <Button Grid.Column="1"
                                        Command="{Binding NavigateToEmployeesCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        HorizontalContentAlignment="Left"
                                        Height="40" Padding="18,0"
                                        Foreground="{DynamicResource MaterialDesignBody}">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="AccountGroupOutline"
                                                     Width="18" Height="18"
                                                     Margin="0,0,14,0" Opacity="0.65"
                                                     VerticalAlignment="Center"/>
                                        <TextBlock Text="Сотрудники"
                                                   FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- Рабочая область-->
            <Border Grid.Column="1"
                    Background="{DynamicResource MaterialDesignCardBackground}">
                <ContentControl Content="{Binding CurrentViewModel}"
                                Margin="32,28,32,28"/>
            </Border>

        </Grid>
    </md:DialogHost>
</Window>
