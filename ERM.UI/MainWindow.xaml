<Window x:Class="ERM.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="ERM — Швейный цех" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <md:DialogHost Identifier="RootDialog" DialogTheme="Inherit">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource MaterialDesignPaper}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <!-- Для справочников внизу -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="24,32,24,32" Orientation="Horizontal">
                        <md:PackIcon Kind="Database" Width="32" Height="32" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="ERM System" FontSize="22" FontWeight="Bold" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- ГЛАВНОЕ МЕНЮ (РАБОТА) -->
                    <StackPanel Grid.Row="1" Margin="12,0">
                        <TextBlock Text="РАБОЧАЯ СМЕНА" FontSize="12" FontWeight="Bold" Foreground="Gray" Margin="16,8,0,8"/>

                        <!-- Тут будет биндинг на Dashboard -->
                        <Button Command="{Binding NavigateToDashboardCommand}" 
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalContentAlignment="Left" Height="50" Margin="0,4"
                                Foreground="{DynamicResource MaterialDesignBody}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ClipboardTextClockOutline" Width="24" Height="24" Margin="0,0,16,0" Opacity="0.8"/>
                                <TextBlock Text="Выдача рулонов" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToCutBatchesCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalContentAlignment="Left" Height="50" Margin="0,4"
                                Foreground="{DynamicResource MaterialDesignBody}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Fabric" Width="24" Height="24" Margin="0,0,16,0" Opacity="0.5"/>
                                <TextBlock Text="Ввод кроя" FontSize="15" VerticalAlignment="Center" Opacity="0.5"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- СПРАВОЧНИКИ (В САМОМ НИЗУ) -->
                    <StackPanel Grid.Row="2" Margin="12,0,12,24">
                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,1,0,0" Margin="0,0,0,8"/>
                        <TextBlock Text="НАСТРОЙКИ" FontSize="12" FontWeight="Bold" Foreground="Gray" Margin="16,8,0,8"/>

                        <Button Command="{Binding NavigateToClothingModelsCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalContentAlignment="Left" Height="40"
                                Foreground="{DynamicResource MaterialDesignBody}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="TshirtCrew" Width="20" Height="20" Margin="0,0,16,0" Opacity="0.7"/>
                                <TextBlock Text="Модели одежды" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateToEmployeesCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalContentAlignment="Left" Height="40"
                                Foreground="{DynamicResource MaterialDesignBody}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="AccountGroup" Width="20" Height="20" Margin="0,0,16,0" Opacity="0.7"/>
                                <TextBlock Text="Сотрудники" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="{DynamicResource MaterialDesignCardBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <md:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="24,16" md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <TextBlock Text="Рабочая область" FontSize="20" VerticalAlignment="Center" FontWeight="Medium"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource MaterialDesignToolForegroundButton}" ToolTip="Профиль пользователя">
                                <md:PackIcon Kind="AccountCircle" Width="24" Height="24"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </md:ColorZone>

                <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="24"/>
            </Grid>
        </Grid>
    </md:DialogHost>
</Window>