<UserControl x:Class="ERM.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"   />
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Журнал смены"
                           Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                           FontWeight="Bold"/>
                <TextBlock Text="Быстрая выдача и история за сегодня"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           FontSize="13" Margin="0,2,0,0" Opacity="0.7"/>
            </StackPanel>

            <ProgressBar IsIndeterminate="True" Width="120"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>

        <!-- ПАНЕЛЬ БЫСТРОЙ ВЫДАЧИ -->
        <md:Card Grid.Row="1" Margin="0,0,0,20"
                 md:ElevationAssist.Elevation="Dp2" UniformCornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Акцентная левая полоса (primary) -->
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Rectangle Grid.Column="0"
                           Fill="{DynamicResource PrimaryHueMidBrush}"/>

                <StackPanel Grid.Column="1">

                    <!-- ── Заголовок секции ── -->
                    <Border Padding="24,18,24,14"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource PrimaryHueLightBrush}"
                                    CornerRadius="6" Width="32" Height="32"
                                    Margin="0,0,12,0">
                                <md:PackIcon Kind="LightningBolt"
                                             Width="16" Height="16"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Быстрая выдача"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource MaterialDesignBody}"/>
                                <TextBlock Text="Выберите швею, крой и укажите параметры"
                                           FontSize="11"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           Opacity="0.7"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── Поля формы ── -->
                    <Border Padding="24,18,24,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Строка 1: Швея + Крой -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="1.6*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Швея -->
                                <ComboBox Grid.Column="0"
                                          md:HintAssist.Hint="Швея"
                                          md:HintAssist.IsFloating="True"
                                          ItemsSource="{Binding Seamstresses}"
                                          SelectedItem="{Binding SelectedSeamstress}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          TextSearch.TextPath="DisplayInfo"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          FontSize="14">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="AccountOutline"
                                                             Width="14" Height="14"
                                                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding DisplayInfo}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Крой -->
                                <ComboBox Grid.Column="2"
                                          md:HintAssist.Hint="Модель и цвет (остаток)"
                                          md:HintAssist.IsFloating="True"
                                          ItemsSource="{Binding AvailableCutItems}"
                                          SelectedItem="{Binding SelectedCutItem}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          TextSearch.TextPath="ClothingModelName"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          FontSize="14">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ClothingModelName}"
                                                               FontWeight="Medium" FontSize="13"/>
                                                    <TextBlock Text=" · " Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                               FontSize="13"/>
                                                    <TextBlock Text="{Binding Color}"
                                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                               FontSize="13"/>
                                                </StackPanel>

                                                <!-- Остаток в бейдже -->
                                                <Border Grid.Column="1"
                                                        Background="{DynamicResource PrimaryHueLightBrush}"
                                                        CornerRadius="5" Padding="6,2"
                                                        VerticalAlignment="Center"
                                                        Margin="12,0,4,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding AvailableQuantity}"
                                                                   FontSize="12" FontWeight="Bold"
                                                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                        <TextBlock Text=" шт"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <!-- Строка 2: Размер + Кол-во + Кнопка -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Размер -->
                                <ComboBox Grid.Column="0"
                                          md:HintAssist.Hint="Размер"
                                          md:HintAssist.IsFloating="True"
                                          ItemsSource="{Binding AvailableSizes}"
                                          SelectedItem="{Binding SelectedSize}"
                                          IsEditable="True"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          FontSize="14"/>

                                <!-- Количество -->
                                <TextBox Grid.Column="2"
                                         md:HintAssist.Hint="Количество, шт"
                                         md:HintAssist.IsFloating="True"
                                         Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="14">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding IssueWorkCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>

                                <!-- Сообщение об ошибке — встроено в сетку, между полями и кнопкой -->
                                <Border Grid.Column="4"
                                        CornerRadius="8" Padding="12,8"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ErrorMessage, Converter={StaticResource NullToBool}}" Value="True">
                                                    <Setter Property="Background" Value="#FFEBEE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                                        <md:PackIcon Kind="AlertCircleOutline"
                                                     Width="15" Height="15"
                                                     Foreground="#E53935"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding ErrorMessage}"
                                                   Foreground="#E53935"
                                                   FontSize="13" FontWeight="Medium"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Кнопка ВЫДАТЬ -->
                                <Button Grid.Column="6"
                                        Command="{Binding IssueWorkCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Height="42" Padding="24,0"
                                        md:ButtonAssist.CornerRadius="8"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="LightningBolt"
                                                     Width="17" Height="17"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>
                                        <TextBlock Text="Выдать"
                                                   FontSize="14" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                </StackPanel>
            </Grid>
        </md:Card>

        <!-- ЗАГОЛОВОК ТАБЛИЦЫ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    Margin="0,0,0,10" VerticalAlignment="Center">
            <md:PackIcon Kind="ClipboardListOutline"
                         Width="16" Height="16"
                         Foreground="{DynamicResource MaterialDesignBodyLight}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" Opacity="0.6"/>
            <TextBlock Text="ВЫДАЧИ ЗА СЕГОДНЯ"
                       FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       Opacity="0.6" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ТАБЛИЦА ВЫДАЧ -->
        <md:Card Grid.Row="3" md:ElevationAssist.Elevation="Dp2" UniformCornerRadius="10">
            <DataGrid ItemsSource="{Binding TodayAssignments}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column"
                      BorderThickness="0" Background="Transparent"
                      RowHeight="52"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      md:DataGridAssist.ColumnHeaderPadding="16,14"
                      md:DataGridAssist.CellPadding="16,0">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader"
                           BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Opacity" Value="0.6"/>
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                        <Setter Property="Background" Value="{DynamicResource MaterialDesignToolBarBackground}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow"
                           BasedOn="{StaticResource MaterialDesignDataGridRow}">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>

                    <!-- Швея -->
                    <DataGridTemplateColumn Header="Швея" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource PrimaryHueLightBrush}"
                                            CornerRadius="6" Width="28" Height="28"
                                            Margin="0,0,10,0">
                                        <md:PackIcon Kind="AccountOutline"
                                                     Width="14" Height="14"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SeamstressName}"
                                                   FontWeight="Medium" FontSize="13"/>
                                        <TextBlock Text="{Binding MachineNumber, StringFormat='Машина №{0}'}"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   FontSize="11" Opacity="0.7"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Модель -->
                    <DataGridTextColumn Header="Модель" Binding="{Binding ClothingModelName}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Цвет -->
                    <DataGridTextColumn Header="Цвет" Binding="{Binding Color}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Размер — бейдж -->
                    <DataGridTemplateColumn Header="Размер" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource MaterialDesignToolBarBackground}"
                                        CornerRadius="6" Padding="10,4"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Size}"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Количество — акцентный бейдж -->
                    <DataGridTemplateColumn Header="Кол-во" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PrimaryHueLightBrush}"
                                        CornerRadius="6" Padding="10,4"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Quantity, StringFormat='{}{0} шт'}"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Отмена выдачи -->
                    <DataGridTemplateColumn Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MaterialDesignToolButton}"
                                        Command="{Binding DataContext.DeleteAssignmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Отменить выдачу"
                                        Width="32" Height="32" Padding="0"
                                        HorizontalAlignment="Center">
                                    <md:PackIcon Kind="CloseCircleOutline"
                                                 Width="16" Height="16"
                                                 Foreground="#E53935"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </md:Card>
    </Grid>
</UserControl>
