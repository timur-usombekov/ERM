<UserControl x:Class="ERM.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Шапка -->
            <RowDefinition Height="Auto" />
            <!-- Панель выдачи -->
            <RowDefinition Height="*" />
            <!-- Таблица -->
        </Grid.RowDefinitions>

        <!-- 1. ШАПКА -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Журнал смены" Style="{StaticResource MaterialDesignHeadline4TextBlock}" />
                <TextBlock Text="Быстрая выдача и история за сегодня" Foreground="Gray" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>

            <ProgressBar IsIndeterminate="True" Width="100" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!-- 2. ПАНЕЛЬ БЫСТРОЙ ВЫДАЧИ -->
        <md:Card Grid.Row="1" Margin="0,0,0,24" Padding="24,16" md:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
            <StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <!-- Швея -->
                    <ComboBox Grid.Row="0" Grid.Column="0" 
                              md:HintAssist.Hint="Швея (Поиск по № или Имени)" 
                              ItemsSource="{Binding Seamstresses}" 
                              SelectedItem="{Binding SelectedSeamstress}"
                              IsEditable="True" 
                              IsTextSearchEnabled="True" 
                              TextSearch.TextPath="DisplayInfo"
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}" FontSize="15">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayInfo}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Крой -->
                    <ComboBox Grid.Row="0" Grid.Column="2" 
                              md:HintAssist.Hint="Модель и Цвет (Остаток)" 
                              ItemsSource="{Binding AvailableCutItems}" 
                              SelectedItem="{Binding SelectedCutItem}"
                              IsEditable="True" 
                              IsTextSearchEnabled="True" 
                              TextSearch.TextPath="ClothingModelName"
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}" FontSize="15">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding ClothingModelName}" FontWeight="Bold"/>
                                    <Run Text=" | " Foreground="Gray"/>
                                    <Run Text="{Binding Color}"/>
                                    <Run Text=" (Ост: " Foreground="Teal"/>
                                    <Run Text="{Binding AvailableQuantity}" Foreground="Teal" FontWeight="Bold"/>
                                    <Run Text="шт)" Foreground="Teal"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Размер, Кол-во и Кнопка -->
                    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Размер -->
                        <ComboBox Grid.Column="0" md:HintAssist.Hint="Размер" 
                                  ItemsSource="{Binding AvailableSizes}" 
                                  SelectedItem="{Binding SelectedSize}"
                                  IsEditable="True"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}" FontSize="15"/>

                        <!-- Количество -->
                        <TextBox Grid.Column="2" md:HintAssist.Hint="Кол-во" 
                                 Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" FontSize="15">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding IssueWorkCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- Кнопка -->
                        <Button Grid.Column="4" Command="{Binding IssueWorkCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}" 
                                Height="45" Padding="24,0" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="LightningBolt" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Text="ВЫДАТЬ" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <!-- Ошибка валидации -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#E53935" FontWeight="Medium" 
                           Margin="0,16,0,0" HorizontalAlignment="Right"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
        </md:Card>

        <!-- 3. ТАБЛИЦА СЕГОДНЯШНИХ ВЫДАЧ -->
        <md:Card Grid.Row="2" md:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
            <DataGrid ItemsSource="{Binding TodayAssignments}" 
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      Background="Transparent" BorderThickness="0">
                <DataGrid.Columns>

                    <DataGridTemplateColumn Header="Швея" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <md:PackIcon Kind="FabricOutline" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SeamstressName}" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MachineNumber, StringFormat=' (№{0})'}" Foreground="Gray" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Модель" Binding="{Binding ClothingModelName}" Width="2*" />
                    <DataGridTextColumn Header="Цвет" Binding="{Binding Color}" Width="*" />

                    <DataGridTemplateColumn Header="Размер" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource MaterialDesignDivider}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Size}" FontWeight="Bold" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Кол-во" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Quantity, StringFormat='{}{0} шт'}" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Кнопка удаления (Отмена выдачи) -->
                    <DataGridTemplateColumn Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MaterialDesignToolButton}"
                                        Command="{Binding DataContext.DeleteAssignmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" ToolTip="Отменить выдачу">
                                    <md:PackIcon Kind="Close" Foreground="#E53935"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </md:Card>
    </Grid>
</UserControl>