<UserControl x:Class="ERM.UI.Views.Dialogs.AddCutBatchDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             MinWidth="350">
    <md:Card Padding="32" UniformCornerRadius="8">
        <StackPanel>
            <TextBlock Text="Новый крой (от закройщика)" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,24" />

            <TextBox md:HintAssist.Hint="Название (например: Батал от 10.05)"
                     md:HintAssist.IsFloating="True"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,16" FontSize="15" />

            <DatePicker md:HintAssist.Hint="Дата кроя"
                        md:HintAssist.IsFloating="True"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                        SelectedDate="{Binding Date}"
                        Margin="0,0,0,16" FontSize="15" />

            <TextBox md:HintAssist.Hint="Общее кол-во (заявлено)"
                     md:HintAssist.IsFloating="True"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding DeclaredQuantityText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,24" FontSize="15" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{x:Static md:DialogHost.CloseDialogCommand}" CommandParameter="{x:Null}"
                        Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,8,0" />
                <Button Content="Создать" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{x:Static md:DialogHost.CloseDialogCommand}" CommandParameter="{Binding}" IsEnabled="{Binding IsValid}"/>
            </StackPanel>
        </StackPanel>
    </md:Card>
</UserControl>