<UserControl x:Class="ERM.UI.Views.Dialogs.AddAdjustmentDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             MinWidth="380" MaxWidth="480">

    <md:Card UniformCornerRadius="10" md:ElevationAssist.Elevation="Dp4">
        <StackPanel>

            <!-- ── ШАПКА ── -->
            <Border Padding="28,24,28,20" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="{DynamicResource PrimaryHueLightBrush}"
                            BorderThickness="1" CornerRadius="8" Width="44" Height="44" Margin="0,0,16,0">
                        <md:PackIcon Kind="CashPlus" Width="22" Height="22" Foreground="{DynamicResource PrimaryHueMidBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Начисление / Удержание" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}"/>
                        <!-- Имя швеи берем из ViewModel -->
                        <TextBlock Text="{Binding SeamstressName, StringFormat='Сотрудник: {0}'}" FontSize="13" Foreground="{DynamicResource PrimaryHueMidBrush}" FontWeight="Medium" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── ПОЛЯ ── -->
            <StackPanel Margin="28,20,28,0">

                <DatePicker md:HintAssist.Hint="Дата операции"
                            md:HintAssist.IsFloating="True"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            SelectedDate="{Binding SelectedDate}"
                            Margin="0,0,0,16" FontSize="14"/>

                <!-- Если сумма с минусом, будет подчеркиваться красным. Это делается конвертерами, но пока оставим стандартный стиль для простоты -->
                <TextBox md:HintAssist.Hint="Сумма (с минусом для удержания)"
                         md:HintAssist.IsFloating="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16" FontSize="14"/>

                <TextBox md:HintAssist.Hint="Основание (Доплата, Штраф, Аванс)"
                         md:HintAssist.IsFloating="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"/>

            </StackPanel>

            <!-- ── КНОПКИ ── -->
            <Border Padding="28,16,28,24" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,1,0,0" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{x:Static md:DialogHost.CloseDialogCommand}" CommandParameter="{x:Null}"
                            Height="36" Padding="20,0" md:ButtonAssist.CornerRadius="8" Margin="0,0,10,0"/>
                    <Button Content="Сохранить" Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{x:Static md:DialogHost.CloseDialogCommand}" CommandParameter="{Binding}"
                            IsEnabled="{Binding IsValid}" Height="36" Padding="20,0" md:ButtonAssist.CornerRadius="8"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </md:Card>
</UserControl>