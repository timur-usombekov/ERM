<UserControl x:Class="ERM.UI.Views.Dialogs.AddEmployeeDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             MinWidth="400" MaxWidth="500"
             MaxHeight="600">
    <md:Card Padding="32" UniformCornerRadius="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <md:PackIcon Kind="AccountPlusOutline" Width="28" Height="28" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="Новый сотрудник" Style="{StaticResource MaterialDesignHeadline5TextBlock}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBox md:HintAssist.Hint="ФИО сотрудника"
                         md:HintAssist.IsFloating="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16" FontSize="15" />

                <TextBox md:HintAssist.Hint="Номер телефона"
                         md:HintAssist.IsFloating="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16" FontSize="15" />

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" Content="Является швеёй"
                              IsChecked="{Binding IsSeamstress}"
                              VerticalAlignment="Center" Margin="0,0,16,0" />

                    <TextBox Grid.Column="1" md:HintAssist.Hint="Номер машины"
                             md:HintAssist.IsFloating="True"
                             Text="{Binding MachineNumber, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="15">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                <Setter Property="Opacity" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSeamstress}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <TextBox md:HintAssist.Hint="Примечания (необязательно)"
                         md:HintAssist.IsFloating="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,24" FontSize="15" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{x:Static md:DialogHost.CloseDialogCommand}" CommandParameter="{x:Null}"
                            Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,8,0" Width="100"/>
                    <Button Content="Сохранить" Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{x:Static md:DialogHost.CloseDialogCommand}" CommandParameter="{Binding}" Width="120"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </md:Card>
</UserControl>