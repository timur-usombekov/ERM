<UserControl x:Class="ERM.UI.Views.Dialogs.AddEmployeeDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             MinWidth="400" MaxWidth="500" MaxHeight="640">

    <md:Card UniformCornerRadius="10" md:ElevationAssist.Elevation="Dp4">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- ── ШАПКА ── -->
                <Border Padding="28,24,28,20"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="Transparent"
                                BorderBrush="{DynamicResource PrimaryHueLightBrush}"
                                BorderThickness="1"
                                CornerRadius="8" Width="44" Height="44"
                                Margin="0,0,16,0">
                            <md:PackIcon Kind="AccountPlusOutline"
                                         Width="22" Height="22"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Новый сотрудник"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                            <TextBlock Text="Заполните данные для создания профиля"
                                       FontSize="12"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       Opacity="0.7" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── ПОЛЯ ── -->
                <StackPanel Margin="28,20,28,0">

                    <TextBox md:HintAssist.Hint="ФИО сотрудника"
                             md:HintAssist.IsFloating="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16" FontSize="14"/>

                    <TextBox md:HintAssist.Hint="Номер телефона"
                             md:HintAssist.IsFloating="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16" FontSize="14"/>

                    <!-- Чекбокс + поле машины в одной строке -->
                    <Border Background="{DynamicResource MaterialDesignToolBarBackground}"
                            CornerRadius="8" Padding="14,12"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      Content="Является швеёй"
                                      IsChecked="{Binding IsSeamstress}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,16,0"/>

                            <TextBox Grid.Column="1"
                                     md:HintAssist.Hint="Номер машины"
                                     md:HintAssist.IsFloating="True"
                                     Text="{Binding MachineNumber, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSeamstress}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </Border>

                    <TextBox md:HintAssist.Hint="Примечания (необязательно)"
                             md:HintAssist.IsFloating="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="80" VerticalScrollBarVisibility="Auto"
                             FontSize="14"/>

                </StackPanel>

                <!-- ── КНОПКИ ── -->
                <Border Padding="28,16,28,24"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="0,1,0,0"
                        Margin="0,20,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{x:Static md:DialogHost.CloseDialogCommand}"
                                CommandParameter="{x:Null}"
                                Height="36" Padding="20,0"
                                md:ButtonAssist.CornerRadius="8"
                                Margin="0,0,10,0"/>
                        <Button Content="Сохранить"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{x:Static md:DialogHost.CloseDialogCommand}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding IsValid}"
                                Height="36" Padding="20,0"
                                md:ButtonAssist.CornerRadius="8"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </md:Card>
</UserControl>
