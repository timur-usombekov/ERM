<UserControl x:Class="ERM.UI.Views.Dialogs.ErrorDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             MaxWidth="400">
    <md:Card Padding="32" UniformCornerRadius="8" BorderBrush="#E53935" BorderThickness="2,0,0,0">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <md:PackIcon Kind="AlertCircle" Width="32" Height="32" Foreground="#E53935" Margin="0,0,12,0"/>
                <TextBlock Text="Ошибка операции" Style="{StaticResource MaterialDesignHeadline6TextBlock}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="15" Margin="0,0,0,24" />

            <Button Content="Понятно" Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{x:Static md:DialogHost.CloseDialogCommand}" CommandParameter="{x:Null}"
                    Foreground="#E53935" HorizontalAlignment="Right" />
        </StackPanel>
    </md:Card>
</UserControl>