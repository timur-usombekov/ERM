<UserControl x:Class="ERM.UI.Views.Dialogs.ErrorDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             MaxWidth="420" MinWidth="340">

    <md:Card UniformCornerRadius="10" md:ElevationAssist.Elevation="Dp4">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Левая акцентная полоса — красная -->
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Rectangle Grid.Column="0" Fill="#E53935"/>

            <StackPanel Grid.Column="1">

                <!-- ── ШАПКА ── -->
                <Border Padding="24,24,24,16"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#FFEBEE"
                                CornerRadius="8" Width="44" Height="44"
                                Margin="0,0,16,0">
                            <md:PackIcon Kind="AlertCircle"
                                         Width="22" Height="22"
                                         Foreground="#E53935"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Ошибка операции"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                            <TextBlock Text="Не удалось выполнить действие"
                                       FontSize="12" Foreground="#E53935"
                                       Opacity="0.8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── ТЕКСТ ОШИБКИ ── -->
                <Border Padding="24,16,24,0">
                    <!-- Блок с текстом ошибки — слегка выделен фоном -->
                    <Border Background="#FFF5F5"
                            CornerRadius="8" Padding="14,12">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   LineHeight="20"
                                   Foreground="#B71C1C"/>
                    </Border>
                </Border>

                <!-- ── КНОПКА ── -->
                <Border Padding="24,16,24,24"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="0,1,0,0"
                        Margin="0,16,0,0">
                    <Button Content="Понятно"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{x:Static md:DialogHost.CloseDialogCommand}"
                            CommandParameter="{x:Null}"
                            Background="#E53935" BorderBrush="#E53935" Foreground="White"
                            HorizontalAlignment="Right"
                            Height="36" Padding="24,0"
                            md:ButtonAssist.CornerRadius="8"/>
                </Border>

            </StackPanel>
        </Grid>
    </md:Card>
</UserControl>
