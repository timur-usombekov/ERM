<UserControl x:Class="ERM.UI.Views.Dialogs.AddCutBatchItemDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             MinWidth="350">
    <md:Card Padding="32" UniformCornerRadius="8">
        <StackPanel>
            <TextBlock Text="Добавить крой" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,24" />

            <!-- Выпадающий список моделей -->
            <ComboBox md:HintAssist.Hint="Модель одежды"
                      md:HintAssist.IsFloating="True"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      ItemsSource="{Binding AvailableModels}"
                      SelectedItem="{Binding SelectedModel}"
                      DisplayMemberPath="Name"
                      Margin="0,0,0,16" FontSize="15" />

            <!-- Ввод цвета -->
            <ComboBox md:HintAssist.Hint="Цвет (Выберите или впишите новый)"
                      md:HintAssist.IsFloating="True"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      IsEditable="True"
                      ItemsSource="{Binding AvailableColors}"
                      DisplayMemberPath="Name"
                      Text="{Binding ColorText, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,0,0,16" FontSize="15" />

            <!-- Ввод количества -->
            <TextBox md:HintAssist.Hint="Количество (шт)"
                     md:HintAssist.IsFloating="True"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,24" FontSize="15" />

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{x:Static md:DialogHost.CloseDialogCommand}" CommandParameter="{x:Null}"
                        Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,8,0" />
                <Button Content="Добавить" Style="{StaticResource MaterialDesignRaisedButton}"
                        Command="{x:Static md:DialogHost.CloseDialogCommand}" CommandParameter="{Binding}" />
            </StackPanel>
        </StackPanel>
    </md:Card>
</UserControl>