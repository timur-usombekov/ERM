<UserControl x:Class="ERM.UI.Views.Dialogs.AddClothingModelDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             MinWidth="400" MaxWidth="500" MaxHeight="600">

    <md:Card UniformCornerRadius="10" md:ElevationAssist.Elevation="Dp4">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- ── ШАПКА ── -->
                <Border Padding="28,24,28,20"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- фон иконки -->
                        <Border Grid.Column="0"
                                BorderBrush="{DynamicResource PrimaryHueLightBrush}"
                                BorderThickness="1"
                                CornerRadius="8" Width="44" Height="44"
                                Margin="0,0,16,0">
                            <md:PackIcon Kind="TshirtCrewOutline"
                                        Width="24" Height="24"
                                        Foreground="{DynamicResource PrimaryHueMidBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>   
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Новая модель одежды"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                            <TextBlock Text="Заполните основную информацию о модели"
                                       FontSize="12"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       Opacity="0.7" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── ПОЛЯ ── -->
                <StackPanel Margin="28,20,28,0">

                    <TextBox md:HintAssist.Hint="Название модели"
                             md:HintAssist.IsFloating="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16" FontSize="14"/>
                    <TextBox md:HintAssist.Hint="Цена за пошив 1 шт (грн)"
                             md:HintAssist.IsFloating="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding SewingPriceText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16" FontSize="14"/>

                    <TextBox md:HintAssist.Hint="Описание (особенности кроя, материалы)"
                             md:HintAssist.IsFloating="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="100" MaxHeight="150"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,0" FontSize="14"/>

                </StackPanel>

                <!-- ── КНОПКИ ── -->
                <Border Padding="28,16,28,24"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="0,1,0,0"
                        Margin="0,20,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отмена"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{x:Static md:DialogHost.CloseDialogCommand}"
                                CommandParameter="{x:Null}"
                                Height="36" Padding="20,0"
                                md:ButtonAssist.CornerRadius="8"
                                Margin="0,0,10,0"/>
                        <Button Content="Сохранить"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{x:Static md:DialogHost.CloseDialogCommand}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding IsValid}"
                                Height="36" Padding="20,0"
                                md:ButtonAssist.CornerRadius="8"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </md:Card>
</UserControl>
