<UserControl x:Class="ERM.UI.Views.PayrollView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Зарплаты и Аналитика"
                           Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                           FontWeight="Bold"/>
                <TextBlock Text="Расчет выплат швеям на основе выданного кроя"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           FontSize="13" Margin="0,2,0,0" Opacity="0.7"/>
            </StackPanel>

            <!-- ФИЛЬТРЫ -->
            <md:Card Grid.Column="1"
                     md:ElevationAssist.Elevation="Dp1"
                     UniformCornerRadius="8"
                     Padding="16,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <md:PackIcon Kind="CalendarRangeOutline"
                                 Width="20" Height="20"
                                 Foreground="Gray"
                                 VerticalAlignment="Center"
                                 Margin="0,0,12,0"/>
                    <DatePicker md:HintAssist.Hint="С"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                SelectedDate="{Binding StartDate}"
                                Width="130" Margin="0,0,12,0"/>
                    <TextBlock Text="—" VerticalAlignment="Center"
                               FontWeight="Bold" Foreground="Gray" Margin="0,0,12,0"/>
                    <DatePicker md:HintAssist.Hint="ПО"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                SelectedDate="{Binding EndDate}"
                                Width="130"/>
                </StackPanel>
            </md:Card>
        </Grid>

        <!-- ПРОГРЕСС -->
        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Height="2" Margin="0,0,0,8"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- КОНТЕНТ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- ТАБЛИЦА -->
            <md:Card Grid.Column="0"
                     md:ElevationAssist.Elevation="Dp2"
                     UniformCornerRadius="10"
                     Margin="0,0,20,0">
                <md:Card Grid.Column="0" md:ElevationAssist.Elevation="Dp2" UniformCornerRadius="10" Margin="0,0,24,0">
                    <TabControl Style="{StaticResource MaterialDesignFilledTabControl}" Margin="0" Padding="0" Background="Transparent">
                        <TabItem Header="Швеи">
                            <DataGrid ItemsSource="{Binding SeamstressesPayroll}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          HeadersVisibility="Column" BorderThickness="0" Background="Transparent"
                                          RowHeight="56" RowDetailsVisibilityMode="Collapsed" 
                                          SelectionUnit="FullRow" FocusVisualStyle="{x:Null}"
                                          Style="{StaticResource MaterialDesignDataGrid}"
                                          md:DataGridAssist.ColumnHeaderPadding="16,14" md:DataGridAssist.CellPadding="16,0">

                                <!-- ЗАГОЛОВКИ -->
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader"
                                       BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Opacity" Value="0.6"/>
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                        <Setter Property="Background" Value="{DynamicResource MaterialDesignToolBarBackground}"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <!-- ЯЧЕЙКИ -->
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell"
                                       BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </DataGrid.CellStyle>

                                <DataGrid.Columns>

                                    <!-- РАСКРЫТИЕ -->
                                    <DataGridTemplateColumn Width="Auto" CanUserSort="False">

                                        <DataGridTemplateColumn.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                                <Setter Property="Padding" Value="4,0"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            </Style>
                                        </DataGridTemplateColumn.CellStyle>

                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ToggleButton
                                                HorizontalAlignment="Center"
                                                IsChecked="{Binding Path=DetailsVisibility,
                                                            RelativeSource={RelativeSource AncestorType=DataGridRow},
                                                            Converter={StaticResource VisibilityToBool}}"
                                                Width="32" Height="32"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Foreground="{DynamicResource MaterialDesignBodyLight}">
                                                    <md:PackIcon Width="18" Height="18">
                                                        <md:PackIcon.Style>
                                                            <Style TargetType="md:PackIcon">
                                                                <Setter Property="Kind" Value="ChevronRight"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChecked,
                                                                        RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                        Value="True">
                                                                        <Setter Property="Kind" Value="ChevronDown"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </md:PackIcon.Style>
                                                    </md:PackIcon>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- ШВЕЯ -->
                                    <DataGridTemplateColumn Header="Швея" Width="*" MinWidth="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <md:PackIcon Kind="AccountOutline"
                                                             Width="18" Height="18"
                                                             Margin="0,0,8,0"
                                                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                             VerticalAlignment="Center"/>
                                                    <StackPanel VerticalAlignment="Center" MinWidth="0">
                                                        <TextBlock Text="{Binding EmployeeName}"
                                                               FontWeight="Bold" FontSize="14"
                                                               TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding MachineNumber, StringFormat='Машина №{0}'}"
                                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                               FontSize="12" Opacity="0.8"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- КОЛИЧЕСТВО -->
                                    <DataGridTextColumn Header="Сшито"
                                                    Binding="{Binding TotalItemsProcessed, StringFormat='{}{0} шт'}"
                                                    Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- СДЕЛЬНО -->
                                    <DataGridTextColumn Header="Сдельно"
                                                    Binding="{Binding EarnedByOperations, StringFormat='{}{0:0.##} ₴'}"
                                                    Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- ДОПЛАТЫ -->
                                    <DataGridTextColumn Header="Доплаты" Binding="{Binding TotalAdjustments, StringFormat='{}{0:0.##} ₴'}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                                <!-- Динамический цвет: минус=красный, плюс=зеленый, ноль=серый -->
                                                <Setter Property="Foreground" Value="{Binding TotalAdjustments, Converter={StaticResource AmountToColor}, ConverterParameter='Foreground'}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- СУММА К ВЫДАЧЕ И КНОПКА ВЫПЛАТЫ -->
                                    <DataGridTemplateColumn Header="К выплате" Width="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <!-- Бейдж с суммой -->
                                                    <!-- Фон бейджа зависит от суммы -->
                                                    <Border Background="{Binding TotalToPay, Converter={StaticResource AmountToColor}, ConverterParameter='Background'}" 
                                                        CornerRadius="6" Padding="12,6" Margin="0,0,12,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <!-- Цвет текста зависит от суммы -->
                                                            <TextBlock Text="{Binding TotalToPay, StringFormat='{}{0:0.##}'}" FontSize="14" FontWeight="Bold" 
                                                                   Foreground="{Binding TotalToPay, Converter={StaticResource AmountToColor}, ConverterParameter='Foreground'}"/>
                                                            <TextBlock Text=" ₴" FontSize="14" FontWeight="Bold" Opacity="0.8"
                                                                   Foreground="{Binding TotalToPay, Converter={StaticResource AmountToColor}, ConverterParameter='Foreground'}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- КНОПКА: Показывается, если мы должны денег (> 0) -->
                                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        Command="{Binding DataContext.PayCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding TotalToPay, Converter={StaticResource ZeroToVisibility}}"
                                                        ToolTip="Провести выплату" Height="30" Padding="8,0" md:ButtonAssist.CornerRadius="6">
                                                        <md:PackIcon Kind="CheckAll" Width="16" Height="16"/>
                                                    </Button>

                                                    <!-- ГАЛОЧКА: Показывается, если долгов нет (0) -->
                                                    <md:PackIcon Kind="CheckCircle" Width="20" Height="20" Foreground="#4CAF50" 
                                                             VerticalAlignment="Center" Margin="8,0,0,0"
                                                             Visibility="{Binding TotalToPay, Converter={StaticResource ZeroToInverseVisibility}}"
                                                             ToolTip="Расчет произведен"/>

                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>

                                <!-- ДЕТАЛИ -->
                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource MaterialDesignToolBarBackground}"
                                            Padding="20,16,20,20"
                                            BorderThickness="0,0,0,1"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="1"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- НАЧИСЛЕНИЯ -->
                                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                    <TextBlock Text="РАСШИФРОВКА НАЧИСЛЕНИЙ:"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="Gray" Margin="0,0,0,10"/>
                                                    <ItemsControl ItemsSource="{Binding OperationDetails}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,5">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" MinWidth="80"/>
                                                                        <ColumnDefinition Width="60"/>
                                                                        <ColumnDefinition Width="65"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                           Text="{Binding ModelName}"
                                                                           FontWeight="Medium"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource MaterialDesignBody}"/>
                                                                    <TextBlock Grid.Column="1"
                                                                           Text="{Binding Quantity, StringFormat='{}{0} шт'}"
                                                                           Foreground="Gray" FontWeight="Medium"/>
                                                                    <TextBlock Grid.Column="2"
                                                                           Text="{Binding PricePerUnit, StringFormat='x {0} ₴'}"
                                                                           Foreground="Gray"/>
                                                                    <TextBlock Grid.Column="3"
                                                                           Text="{Binding Sum, StringFormat='{}{0:0.##} ₴'}"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <!-- РАЗДЕЛИТЕЛЬ -->
                                                <Border Grid.Column="1"
                                                    Background="{DynamicResource MaterialDesignDivider}"
                                                    Width="1" Margin="0,4"/>

                                                <!-- ОПЕРАЦИИ -->
                                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                            <md:PackIcon Kind="SwapVertical"
                                                                     Width="16" Height="16"
                                                                     Foreground="Gray"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,6,0"/>
                                                            <TextBlock Text="ФИНАНСОВЫЕ ОПЕРАЦИИ"
                                                                   FontSize="11" FontWeight="Bold"
                                                                   Foreground="Gray"
                                                                   VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <Button Grid.Column="1"
                                                            Command="{Binding DataContext.AddAdjustmentCommand,
                                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                                            Height="28" Padding="10,0"
                                                            md:ButtonAssist.CornerRadius="6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <md:PackIcon Kind="Plus"
                                                                         Width="14" Height="14"
                                                                         Margin="0,0,4,0"/>
                                                                <TextBlock Text="Добавить" FontSize="11"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>

                                                    <ItemsControl ItemsSource="{Binding AdjustmentDetails}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,5">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="80"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                           Text="{Binding Date, StringFormat=dd.MM.yyyy}"
                                                                           Foreground="Gray" FontSize="12"
                                                                           VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1"
                                                                           Text="{Binding Reason}"
                                                                           FontWeight="Medium"
                                                                           Foreground="{DynamicResource MaterialDesignBody}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,0,12,0"/>
                                                                    <TextBlock Grid.Column="2"
                                                                           Text="{Binding Amount, StringFormat='{}{0:0.##} ₴'}"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                           VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Закройщики">
                            <DataGrid ItemsSource="{Binding CuttersPayroll}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" BorderThickness="0" Background="Transparent"
                                  RowHeight="56" RowDetailsVisibilityMode="Collapsed" 
                                  SelectionUnit="FullRow" FocusVisualStyle="{x:Null}"
                                  Style="{StaticResource MaterialDesignDataGrid}"
                                  md:DataGridAssist.ColumnHeaderPadding="16,14" md:DataGridAssist.CellPadding="16,0">

                                <!-- Стили заголовков (такие же) -->
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Opacity" Value="0.6"/>
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                        <Setter Property="Background" Value="{DynamicResource MaterialDesignToolBarBackground}"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </DataGrid.CellStyle>

                                <DataGrid.Columns>
                                    <!-- РАСКРЫТИЕ -->
                                    <DataGridTemplateColumn Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource MaterialDesignExpandCollapseToggleStyle}"
                                                          IsChecked="{Binding Path=DetailsVisibility, RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource VisibilityToBool}}"
                                                          Width="24" Height="24" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- ЗАКРОЙЩИК -->
                                    <DataGridTemplateColumn Header="Закройщик" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Иконка ножниц вместо человечка/машинки -->
                                                    <md:PackIcon Kind="ScissorsCutting" Width="20" Height="20" Margin="0,0,12,0" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding EmployeeName}" FontWeight="Bold" FontSize="14"/>
                                                        <TextBlock Text="Специалист по раскрою" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12" Opacity="0.8"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- КОЛИЧЕСТВО -->
                                    <DataGridTextColumn Header="Скроено единиц" Binding="{Binding TotalItemsProcessed, StringFormat='{}{0} шт'}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- ЗА РАСКРОЙ -->
                                    <DataGridTextColumn Header="За раскрой" Binding="{Binding EarnedByOperations, StringFormat='{}{0:0.##} ₴'}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- АВАНСЫ -->
                                    <DataGridTextColumn Header="Доплаты" Binding="{Binding TotalAdjustments, StringFormat='{}{0:0.##} ₴'}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                                <Setter Property="Foreground" Value="{Binding TotalAdjustments, Converter={StaticResource AmountToColor}, ConverterParameter='Foreground'}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- К ВЫПЛАТЕ -->
                                    <DataGridTemplateColumn Header="К выплате" Width="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="{Binding TotalToPay, Converter={StaticResource AmountToColor}, ConverterParameter='Background'}" CornerRadius="6" Padding="12,6" Margin="0,0,12,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding TotalToPay, StringFormat='{}{0:0.##}'}" FontSize="14" FontWeight="Bold" Foreground="{Binding TotalToPay, Converter={StaticResource AmountToColor}, ConverterParameter='Foreground'}"/>
                                                            <TextBlock Text=" ₴" FontSize="14" FontWeight="Bold" Opacity="0.8" Foreground="{Binding TotalToPay, Converter={StaticResource AmountToColor}, ConverterParameter='Foreground'}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding DataContext.PayCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Visibility="{Binding TotalToPay, Converter={StaticResource ZeroToVisibility}}" ToolTip="Провести выплату" Height="30" Padding="8,0" md:ButtonAssist.CornerRadius="6">
                                                        <md:PackIcon Kind="CheckAll" Width="16" Height="16"/>
                                                    </Button>
                                                    <md:PackIcon Kind="CheckCircle" Width="20" Height="20" Foreground="#4CAF50" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding TotalToPay, Converter={StaticResource ZeroToInverseVisibility}}" ToolTip="Расчет произведен"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>

                                <!-- ДЕТАЛИ -->
                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource MaterialDesignToolBarBackground}" Padding="24,16,24,24" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- ЛЕВАЯ ЧАСТЬ (Раскрой) -->
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <md:PackIcon Kind="ContentCut" Width="16" Height="16" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="РАСШИФРОВКА РАСКРОЯ" FontSize="11" FontWeight="Bold" Foreground="Gray" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <ItemsControl ItemsSource="{Binding OperationDetails}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*"/>
                                                                        <ColumnDefinition Width="1*"/>
                                                                        <ColumnDefinition Width="1*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding ModelName}" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBody}"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='{}{0} шт'}" Foreground="Gray" FontWeight="Medium"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding PricePerUnit, StringFormat='x {0} ₴'}" Foreground="Gray"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding Sum, StringFormat='{}{0:0.##} ₴'}" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <Border Grid.Column="1" Background="{DynamicResource MaterialDesignDivider}" Width="1" Margin="15,0"/>

                                                <!-- ПРАВАЯ ЧАСТЬ (Авансы/Штрафы - остается такой же) -->
                                                <StackPanel Grid.Column="2">
                                                    <Grid Margin="0,0,0,12">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <md:PackIcon Kind="SwapVertical" Width="16" Height="16" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBlock Text="ФИНАНСОВЫЕ ОПЕРАЦИИ" FontSize="11" FontWeight="Bold" Foreground="Gray" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <Button HorizontalAlignment="Right" Command="{Binding DataContext.AddAdjustmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="12,0" md:ButtonAssist.CornerRadius="6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <md:PackIcon Kind="Plus" Width="14" Height="14" Margin="0,0,4,0"/>
                                                                <TextBlock Text="Добавить" FontSize="11"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>

                                                    <ItemsControl ItemsSource="{Binding AdjustmentDetails}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="80"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding Date, StringFormat=dd.MM.yyyy}" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Reason}" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBody}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat='{}{0:0.##} ₴'}" FontWeight="Bold" Foreground="{Binding Amount, Converter={StaticResource AmountToColor}, ConverterParameter='Foreground'}" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Гладильщицы">
                            <DataGrid ItemsSource="{Binding IronersPayroll}"
              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
              HeadersVisibility="Column" BorderThickness="0" Background="Transparent"
              RowHeight="56" RowDetailsVisibilityMode="Collapsed" 
              SelectionUnit="FullRow" FocusVisualStyle="{x:Null}"
              Style="{StaticResource MaterialDesignDataGrid}"
              md:DataGridAssist.ColumnHeaderPadding="16,14" md:DataGridAssist.CellPadding="16,0">

                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Opacity" Value="0.6"/>
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                        <Setter Property="Background" Value="{DynamicResource MaterialDesignToolBarBackground}"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </DataGrid.CellStyle>

                                <DataGrid.Columns>
                                    <!-- РАСКРЫТИЕ -->
                                    <DataGridTemplateColumn Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource MaterialDesignExpandCollapseToggleStyle}"
                                      IsChecked="{Binding Path=DetailsVisibility, RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource VisibilityToBool}}"
                                      Width="24" Height="24" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- ГЛАДИЛЬЩИЦА -->
                                    <DataGridTemplateColumn Header="Гладильщица" Width="2*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Иконка утюга -->
                                                    <md:PackIcon Kind="Iron" Width="20" Height="20" Margin="0,0,12,0" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding EmployeeName}" FontWeight="Bold" FontSize="14"/>
                                                        <TextBlock Text="Специалист ВТО" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12" Opacity="0.8"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- КОЛИЧЕСТВО -->
                                    <DataGridTextColumn Header="Отглажено единиц" Binding="{Binding TotalItemsProcessed, StringFormat='{}{0} шт'}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- ЗА ГЛАЖКУ -->
                                    <DataGridTextColumn Header="Сдельно" Binding="{Binding EarnedByOperations, StringFormat='{}{0:0.##} ₴'}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- ДОПЛАТЫ / ШТРАФЫ -->
                                    <DataGridTextColumn Header="Корректировки" Binding="{Binding TotalAdjustments, StringFormat='{}{0:0.##} ₴'}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                                <Setter Property="Foreground" Value="{Binding TotalAdjustments, Converter={StaticResource AmountToColor}, ConverterParameter='Foreground'}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- К ВЫПЛАТЕ -->
                                    <DataGridTemplateColumn Header="К выплате" Width="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="{Binding TotalToPay, Converter={StaticResource AmountToColor}, ConverterParameter='Background'}" CornerRadius="6" Padding="12,6" Margin="0,0,12,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding TotalToPay, StringFormat='{}{0:0.##}'}" FontSize="14" FontWeight="Bold" Foreground="{Binding TotalToPay, Converter={StaticResource AmountToColor}, ConverterParameter='Foreground'}"/>
                                                            <TextBlock Text=" ₴" FontSize="14" FontWeight="Bold" Opacity="0.8" Foreground="{Binding TotalToPay, Converter={StaticResource AmountToColor}, ConverterParameter='Foreground'}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding DataContext.PayCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Visibility="{Binding TotalToPay, Converter={StaticResource ZeroToVisibility}}" ToolTip="Провести выплату" Height="30" Padding="8,0" md:ButtonAssist.CornerRadius="6">
                                                        <md:PackIcon Kind="CheckAll" Width="16" Height="16"/>
                                                    </Button>
                                                    <md:PackIcon Kind="CheckCircle" Width="20" Height="20" Foreground="#4CAF50" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding TotalToPay, Converter={StaticResource ZeroToInverseVisibility}}" ToolTip="Расчет произведен"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>

                                <!-- ДЕТАЛИ -->
                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource MaterialDesignToolBarBackground}" Padding="24,16,24,24" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- ЛЕВАЯ ЧАСТЬ (Глажка) -->
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <md:PackIcon Kind="IronBoard" Width="16" Height="16" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="РАСШИФРОВКА ГЛАЖКИ" FontSize="11" FontWeight="Bold" Foreground="Gray" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <ItemsControl ItemsSource="{Binding OperationDetails}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*"/>
                                                                        <ColumnDefinition Width="1*"/>
                                                                        <ColumnDefinition Width="1*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="{Binding ModelName}" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBody}"/>
                                                                        <!-- Вот тут выводим OperationName, если подменщица (будет написано "ВТО / Глажка") -->
                                                                        <TextBlock Text="{Binding OperationName}" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Opacity="0.8"/>
                                                                    </StackPanel>

                                                                    <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='{}{0} шт'}" Foreground="Gray" FontWeight="Medium" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding PricePerUnit, StringFormat='x {0} ₴'}" Foreground="Gray" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding Sum, StringFormat='{}{0:0.##} ₴'}" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <Border Grid.Column="1" Background="{DynamicResource MaterialDesignDivider}" Width="1" Margin="15,0"/>

                                                <!-- ПРАВАЯ ЧАСТЬ (Авансы/Штрафы) -->
                                                <StackPanel Grid.Column="2">
                                                    <Grid Margin="0,0,0,12">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <md:PackIcon Kind="SwapVertical" Width="16" Height="16" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBlock Text="ФИНАНСОВЫЕ ОПЕРАЦИИ" FontSize="11" FontWeight="Bold" Foreground="Gray" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <Button HorizontalAlignment="Right" Command="{Binding DataContext.AddAdjustmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="12,0" md:ButtonAssist.CornerRadius="6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <md:PackIcon Kind="Plus" Width="14" Height="14" Margin="0,0,4,0"/>
                                                                <TextBlock Text="Добавить" FontSize="11"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>

                                                    <ItemsControl ItemsSource="{Binding AdjustmentDetails}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="80"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding Date, StringFormat=dd.MM.yyyy}" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Reason}" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBody}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat='{}{0:0.##} ₴'}" FontWeight="Bold" Foreground="{Binding Amount, Converter={StaticResource AmountToColor}, ConverterParameter='Foreground'}" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </md:Card>
            </md:Card>

            <!-- ИТОГИ -->
            <md:Card Grid.Column="1"
                     md:ElevationAssist.Elevation="Dp2"
                     UniformCornerRadius="10"
                     VerticalAlignment="Top">
                <Border Padding="24">
                    <StackPanel>
                        <md:PackIcon Kind="CashMultiple"
                                     Width="32" Height="32"
                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                     Margin="0,0,0,16"/>
                        <TextBlock Text="ОБЩИЙ ФОНД ЗП"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="Gray" Margin="0,0,0,4"/>
                        <TextBlock Text="Сумма к выплате всем швеям за выбранный период"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="Gray" Opacity="0.8"
                                   Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:0.##}'}"
                                       FontSize="36" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text=" ₴"
                                       FontSize="20" FontWeight="Medium"
                                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                                       VerticalAlignment="Bottom"
                                       Margin="4,0,0,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </md:Card>

        </Grid>
    </Grid>
</UserControl>