<UserControl x:Class="ERM.UI.Views.PayrollView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Зарплаты и Аналитика" Style="{StaticResource MaterialDesignHeadline4TextBlock}" FontWeight="Bold"/>
                <TextBlock Text="Расчет выплат швеям на основе выданного кроя" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="13" Margin="0,2,0,0" Opacity="0.7"/>
            </StackPanel>

            <!-- ФИЛЬТРЫ -->
            <md:Card Grid.Column="1" md:ElevationAssist.Elevation="Dp1" UniformCornerRadius="8" Padding="16,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <md:PackIcon Kind="CalendarRangeOutline" Width="20" Height="20" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <DatePicker md:HintAssist.Hint="С"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                SelectedDate="{Binding StartDate}"
                                Width="120" Margin="0,0,12,0"/>

                    <TextBlock Text="—" VerticalAlignment="Center" FontWeight="Bold" Foreground="Gray" Margin="0,0,12,0"/>

                    <DatePicker md:HintAssist.Hint="ПО"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                SelectedDate="{Binding EndDate}"
                                Width="120"/>
                </StackPanel>
            </md:Card>
        </Grid>

        <!-- ПРОГРЕСС -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" Margin="0,0,0,8" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- КОНТЕНТ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ТАБЛИЦА -->
            <md:Card Grid.Column="0" md:ElevationAssist.Elevation="Dp2" UniformCornerRadius="10" Margin="0,0,24,0">
                <DataGrid ItemsSource="{Binding PayrollList}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" BorderThickness="0" Background="Transparent" RowHeight="56"
                          RowDetailsVisibilityMode="Collapsed" 
                          SelectionUnit="FullRow" FocusVisualStyle="{x:Null}"
                          Style="{StaticResource MaterialDesignDataGrid}" md:DataGridAssist.ColumnHeaderPadding="16,14" md:DataGridAssist.CellPadding="16,0">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Opacity" Value="0.6"/>
                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                            <Setter Property="Background" Value="{DynamicResource MaterialDesignToolBarBackground}"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.CellStyle>


                    <DataGrid.Columns>

                        <!-- РАСКРЫТИЕ -->
                        <DataGridTemplateColumn Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource MaterialDesignExpandCollapseToggleStyle}"
                                                  IsChecked="{Binding Path=DetailsVisibility, RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource VisibilityToBool}}"
                                                  Width="24" Height="24" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ШВЕЯ -->
                        <DataGridTemplateColumn Header="Швея" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <md:PackIcon Kind="AccountOutline" Width="20" Height="20" Margin="0,0,12,0" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SeamstressName}" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="{Binding MachineNumber, StringFormat='Машина №{0}'}" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12" Opacity="0.8"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- КОЛИЧЕСТВО -->
                        <DataGridTextColumn Header="Сшито единиц" Binding="{Binding TotalItemsSewn, StringFormat='{}{0} шт'}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- СУММА -->
                        <DataGridTemplateColumn Header="Итого к выплате" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#E8F5E9" CornerRadius="6" Padding="12,6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding TotalSalary, StringFormat='{}{0:0.##}'}" FontSize="14" FontWeight="Bold" Foreground="#2E7D32"/>
                                            <TextBlock Text=" ₴" FontSize="14" FontWeight="Bold" Foreground="#2E7D32" Opacity="0.8"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                    <!-- ДЕТАЛИ -->
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource MaterialDesignToolBarBackground}" Padding="16,12,16,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                                <StackPanel>
                                    <TextBlock Text="РАСШИФРОВКА НАЧИСЛЕНИЙ:" FontSize="11" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,12"/>
                                    <ItemsControl ItemsSource="{Binding Details}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding ModelName}" FontWeight="Medium" Foreground="{DynamicResource MaterialDesignBody}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='{}{0} шт'}" Foreground="Gray" FontWeight="Medium"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding PricePerUnit, StringFormat='x {0} ₴'}" Foreground="Gray"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Sum, StringFormat='= {0:0.##} ₴'}" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
            </md:Card>

            <!-- ИТОГИ -->
            <md:Card Grid.Column="1" md:ElevationAssist.Elevation="Dp2" UniformCornerRadius="10" VerticalAlignment="Top">
                <Border Padding="24">
                    <StackPanel>
                        <md:PackIcon Kind="CashMultiple" Width="32" Height="32" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,16"/>
                        <TextBlock Text="ОБЩИЙ ФОНД ЗП" FontSize="11" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,4"/>
                        <TextBlock Text="Сумма к выплате всем швеям за выбранный период" TextWrapping="Wrap" FontSize="12" Foreground="Gray" Opacity="0.8" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:0.##}'}" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text=" ₴" FontSize="20" FontWeight="Medium" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Bottom" Margin="4,0,0,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </md:Card>
        </Grid>
    </Grid>
</UserControl>