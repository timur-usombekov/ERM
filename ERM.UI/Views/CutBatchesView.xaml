<UserControl x:Class="ERM.UI.Views.CutBatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Управление кроем"
                           Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                           FontWeight="Bold" />
                <TextBlock Text="Документы раскроя и позиции по моделям"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           FontSize="13" Margin="0,2,0,0" Opacity="0.7"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Command="{Binding AddBatchCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Height="42" Padding="24,0"
                    md:ButtonAssist.CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="PlusCircleOutline" Width="18" Height="18"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Новый документ" FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" Margin="0,0,0,8"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <md:Card Grid.Column="0"
                     md:ElevationAssist.Elevation="Dp1"
                     UniformCornerRadius="10"
                     Background="{DynamicResource MaterialDesignCardBackground}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок панели -->
                    <Border Grid.Row="0" Padding="16,14,16,10"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="FileDocumentOutline"
                                         Width="16" Height="16"
                                         Foreground="{DynamicResource MaterialDesignBodyLight}"
                                         VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7"/>
                            <TextBlock Text="ДОКУМЕНТЫ"
                                       FontSize="11" FontWeight="Bold" 
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       VerticalAlignment="Center" Opacity="0.7"/>
                        </StackPanel>
                    </Border>

                    <!-- Список -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListBox ItemsSource="{Binding Batches}"
                                 SelectedItem="{Binding SelectedBatch}"
                                 HorizontalContentAlignment="Stretch"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="8">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBackground"
                                                        CornerRadius="8"
                                                        Background="Transparent">
                                                    <Grid>
                                                        <Border x:Name="Accent"
                                                                HorizontalAlignment="Left"
                                                                Width="16" 
                                                                BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                                                                BorderThickness="4,1.5,0,1.5" 
                                                                CornerRadius="8,0,0,8"
                                                                Opacity="0"/>                                       
                                                        <ContentPresenter Margin="0"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBackground" Property="Background"
                                                                Value="{DynamicResource MaterialDesignSelection}"/>
                                                        <Setter TargetName="Accent" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBackground" Property="Background"
                                                                Value="{DynamicResource MaterialDesignDivider}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14,12" CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource MaterialDesignBody}"/>
                                                <TextBlock Text="{Binding Date, StringFormat=dd.MM.yyyy}"
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                           FontSize="11" Margin="0,3,0,0" Opacity="0.7"/>
                                            </StackPanel>
                                            <!-- Бейдж с количеством -->
                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource MaterialDesignDivider}"
                                                    CornerRadius="10" Padding="6,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DeclaredQuantity}"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </md:Card>

            <md:Card Grid.Column="2"
                     md:ElevationAssist.Elevation="Dp2"
                     UniformCornerRadius="10"
                     Visibility="{Binding SelectedBatch, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="32,24,24,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedBatch.Title}"
                                               FontSize="24" FontWeight="Bold"
                                               Foreground="{DynamicResource MaterialDesignBody}"/>

                                    <!-- БЕЙДЖ АРХИВА (Показывается только если IsClosed = True) -->
                                    <Border Background="#EEEEEE" CornerRadius="6" Padding="8,4" Margin="12,0,0,0"
                                            Visibility="{Binding SelectedBatch.IsClosed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="ArchiveLockOutline" Width="14" Height="14" Foreground="#757575" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="В АРХИВЕ" Foreground="#757575" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Бейдж «Заявлено» -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                    <Border CornerRadius="6" Padding="10,4">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="PackageVariantClosed"
                                                         Width="14" Height="14"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Заявлено:"
                                                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                       FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SelectedBatch.DeclaredQuantity, StringFormat=' {0} шт'}"
                                                       FontWeight="Bold" FontSize="13"
                                                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            
                            

                            <!-- Кнопки действий -->
                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">

                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Command="{Binding EditBatchCommand}"
                                            CommandParameter="{Binding SelectedBatch}"
                                            Width="38" Height="38" Padding="8" md:ButtonAssist.CornerRadius="8" Margin="0,0,10,0"
                                            BorderBrush="Gray" Foreground="Gray" ToolTip="Редактировать документ">
                                        <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                    </Button>

                                    <!-- КНОПКА: АРХИВИРОВАТЬ -->
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Command="{Binding ToggleBatchStatusCommand}"
                                            CommandParameter="{Binding SelectedBatch}"
                                            Height="38" Padding="12,0" md:ButtonAssist.CornerRadius="8" Margin="0,0,10,0"
                                            BorderBrush="Gray" Foreground="Gray" ToolTip="Закрыть партию (убрать из выдачи)">
                                        <md:PackIcon Kind="ArchiveOutline" Width="18" Height="18"/>
                                    </Button>

                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Command="{Binding AddItemCommand}"
                                            Height="38" Padding="16,0" md:ButtonAssist.CornerRadius="8" Margin="0,0,10,0"
                                            IsEnabled="{Binding SelectedBatch.IsClosed, Converter={StaticResource InverseBoolConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Добавить" VerticalAlignment="Center" FontSize="13"/>
                                        </StackPanel>
                                    </Button>
                                    

                                    <!-- Кнопка удаления -->
                                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Command="{Binding DeleteBatchCommand}"
                                            CommandParameter="{Binding SelectedBatch}"
                                            MinWidth="0" Width="38" Height="38" Padding="8"
                                            md:ButtonAssist.CornerRadius="8" BorderBrush="#FFCDD2" ToolTip="Удалить документ">
                                        <md:PackIcon Kind="TrashCanOutline" Foreground="#D32F2F" Width="18" Height="18"/>
                                    </Button>
                                </StackPanel>

                                <!-- ОШИБКА -->
                                <Border CornerRadius="8" Padding="12,8" VerticalAlignment="Center" Margin="0,6,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ErrorMessage, Converter={StaticResource NullToBoolConverter}}" Value="True">
                                                    <Setter Property="Background" Value="#FFEBEE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
                                        <md:PackIcon Kind="AlertCircleOutline" Width="15" Height="15" Foreground="#E53935" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#E53935" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Border Padding="28">
                            <ItemsControl ItemsSource="{Binding GroupedItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <md:Card md:ElevationAssist.Elevation="Dp2"
                                                 UniformCornerRadius="10"
                                                 Margin="0,0,0,18"
                                                 Background="{DynamicResource MaterialDesignCardBackground}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- Акцентная левая полоса -->
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Цветная полоса слева карточки (primary) -->
                                                <Rectangle Grid.Column="0"
                                                           Fill="{DynamicResource PrimaryHueMidBrush}"/>

                                                <!-- Контент карточки -->
                                                <Grid Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="196"/>
                                                        <ColumnDefinition Width="1"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- ── Левая секция: модель + итого ── -->
                                                    <Border Grid.Column="0" Padding="24,20" VerticalAlignment="Top">
                                                        <StackPanel VerticalAlignment="Top">

                                                            <!-- Лейбл МОДЕЛЬ -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                <md:PackIcon Kind="TshirtCrewOutline"
                                                                             Width="13" Height="13"
                                                                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0,0,5,0" Opacity="0.6"/>
                                                                <TextBlock Text="МОДЕЛЬ"
                                                                           FontSize="10" FontWeight="Bold"
                                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                           Opacity="0.6" VerticalAlignment="Center"/>
                                                            </StackPanel>

                                                            <TextBlock Text="{Binding ModelName}"
                                                                       FontSize="17" FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource MaterialDesignBody}"/>

                                                            <Separator Margin="0,16,0,16"
                                                                       Background="{DynamicResource MaterialDesignDivider}"
                                                                       Opacity="0.5"/>

                                                            <!-- Итого -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <md:PackIcon Kind="Counter"
                                                                             Width="13" Height="13"
                                                                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0,0,5,0" Opacity="0.6"/>
                                                                <TextBlock Text="ИТОГО"
                                                                           FontSize="10" FontWeight="Bold"
                                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                           Opacity="0.6" VerticalAlignment="Center"/>
                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding TotalQuantity}"
                                                                           FontSize="30" FontWeight="Bold"
                                                                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                                <TextBlock Text=" шт"
                                                                           FontSize="16" FontWeight="Medium"
                                                                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                           VerticalAlignment="Bottom"
                                                                           Margin="2,0,0,4"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Вертикальный разделитель -->
                                                    <Border Grid.Column="1"
                                                            Background="{DynamicResource MaterialDesignDivider}"
                                                            Margin="0,16" Opacity="0.6"/>

                                                    <!-- ── Правая секция: цвета ── -->
                                                    <Border Grid.Column="2" Padding="24,20">
                                                        <StackPanel>

                                                            <!-- Заголовок ЦВЕТА -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                                <md:PackIcon Kind="PaletteOutline"
                                                                             Width="13" Height="13"
                                                                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0,0,5,0" Opacity="0.6"/>
                                                                <TextBlock Text="ЦВЕТА"
                                                                           FontSize="10" FontWeight="Bold"
                                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                           Opacity="0.6" VerticalAlignment="Center"/>
                                                            </StackPanel>

                                                            <!-- Строки цветов -->
                                                            <ItemsControl ItemsSource="{Binding CutBatchItems}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Margin="0,3" Padding="12,8"
            CornerRadius="8"
            Background="{DynamicResource MaterialDesignToolBarBackground}">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <!-- Название цвета -->
                                                                                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                                                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource PrimaryHueMidBrush}" Opacity="0.4" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                                                    <TextBlock Text="{Binding Color}" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBody}"/>
                                                                                </StackPanel>

                                                                                <!-- БЕЙДЖ ОСТАТКА (Показывается всегда, красится в оранжевый, если меньше начального) -->
                                                                                <Border Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center"
                    CornerRadius="4" Padding="6,2"
                    BorderThickness="1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <TextBlock Text="Остаток: " FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center"/>
                                                                                        <TextBlock Text="{Binding AvailableQuantity}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                                                                    <!-- Если остаток меньше исходного количества (кто-то взял в работу) - подсвечиваем оранжевым -->
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Value="True">
                                                                                                            <DataTrigger.Binding>
                                                                                                                <MultiBinding Converter="{StaticResource LessThanConverter}">
                                                                                                                    <Binding Path="AvailableQuantity"/>
                                                                                                                    <Binding Path="Quantity"/>
                                                                                                                </MultiBinding>
                                                                                                            </DataTrigger.Binding>
                                                                                                            <Setter Property="Foreground" Value="#FF9800"/>
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                    </StackPanel>
                                                                                </Border>

                                                                                <!-- Общее количество -->
                                                                                <Border Grid.Column="2" CornerRadius="5" Padding="8,3" VerticalAlignment="Center" Background="{DynamicResource MaterialDesignDivider}">
                                                                                    <TextBlock Text="{Binding Quantity, StringFormat='Всего {0} шт'}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource MaterialDesignBody}"
                           Opacity="0.8" VerticalAlignment="Center"/>
                                                                                </Border>

                                                                                <!-- КНОПКИ ДЕЙСТВИЙ (Показываем только если документ открыт) -->
                                                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding DataContext.SelectedBatch.IsClosed, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolConverter}}">

                                                                                    <Button Style="{StaticResource MaterialDesignToolButton}"
                        Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Width="28" Height="28" Padding="0" ToolTip="Редактировать">
                                                                                        <md:PackIcon Kind="PencilOutline" Width="14" Height="14" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                                                    </Button>

                                                                                    <Button Style="{StaticResource MaterialDesignToolButton}"
                        Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Width="28" Height="28" Padding="0" Margin="4,0,0,0" ToolTip="Удалить">
                                                                                        <md:PackIcon Kind="TrashCanOutline" Width="14" Height="14" Foreground="#E53935"/>
                                                                                    </Button>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </md:Card>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </md:Card>
        </Grid>
    </Grid>
</UserControl>
