<UserControl x:Class="ERM.UI.Views.CutBatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Управление кроем (от закройщика)" Style="{StaticResource MaterialDesignHeadline4TextBlock}" VerticalAlignment="Center"/>

            <Button Grid.Column="1" Command="{Binding AddBatchCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="Новый крой (Документ)" Height="40" />
        </Grid>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="2" Margin="0,0,0,8"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Основная рабочая область (Слева списки, справа детали) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="16" />
                <!-- Разделитель -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ ПАНЕЛЬ: Список партий (бумажек) -->
            <md:Card Grid.Column="0" md:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8">
                <ListBox ItemsSource="{Binding Batches}" 
                         SelectedItem="{Binding SelectedBatch}"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15"/>
                                <TextBlock Text="{Binding Date, StringFormat=dd.MM.yyyy}" Foreground="Gray" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </md:Card>

            <!-- ПРАВАЯ ПАНЕЛЬ: Детали выбранной партии -->
            <md:Card Grid.Column="2" md:ElevationAssist.Elevation="Dp2" UniformCornerRadius="8" 
                     Visibility="{Binding SelectedBatch}">
                <!-- Visibility="{Binding SelectedBatch, Converter={StaticResource NullToVisibilityConverter}-->
                <!-- TODO: NullToVisibilityConverter нужно будет добавить, или обойтись без него (тогда пустая карточка будет видна) -->

                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Шапка документа -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="{Binding SelectedBatch.Title}" FontSize="20" FontWeight="Medium" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource MaterialDesignToolButton}" 
                                    ToolTip="Удалить документ" Command="{Binding DeleteBatchCommand}" 
                                    CommandParameter="{Binding SelectedBatch}">
                                <md:PackIcon Kind="TrashCanOutline" Foreground="#E53935" Width="20" Height="20"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Separator Grid.Row="1" Margin="0,0,0,16" Background="{DynamicResource MaterialDesignDivider}"/>

                    <!-- Таблица с моделями и цветами -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0" ItemsSource="{Binding SelectedBatch.Items}" 
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  Style="{StaticResource MaterialDesignDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Модель одежды" Binding="{Binding ClothingModelName}" Width="*" />
                                <DataGridTextColumn Header="Цвет" Binding="{Binding Color}" Width="150" />
                                <DataGridTextColumn Header="Количество (шт)" Binding="{Binding Quantity}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Кнопка добавления новой строчки -->
                        <Button Grid.Row="1" Command="{Binding AddItemCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Content="+ Добавить позицию" Margin="0,16,0,0" HorizontalAlignment="Left" />
                    </Grid>
                </Grid>
            </md:Card>
        </Grid>
    </Grid>
</UserControl>